{
  "name": "build",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "bin": "index.js",
  "scripts": {
    "build": "npm run build:css && npm run build:html && npm run build:js",
    "build:js": "rollup --config",
    "build:css": "cd ..&& postcss **/*.css !**/*.min.css --dir . --base . --ext min.css --use postcss-preset-env --use cssnano --no-map",
    "build:html": "minhtml **/template.html --ignore *.min.* --cwd ..",
    "watch": "npm run build:css -- --watch & npm run build:html -- --watch & (sleep 5 && npm run build:js -- --watch --no-watch.clearScreen)"
  },
  "keywords": [],
  "author": "Fabrice Sanga",
  "license": "ISC",
  "description": "Build command-line approach",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "cssnano": "^7.1.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-preset-env": "^10.4.0",
    "rollup": "^4.50.0",
    "rollup-plugin-string": "^3.0.0"
  }
}