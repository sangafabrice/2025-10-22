{
  "name": "fttl-yt-player",
  "version": "1.0.0",
  "main": "src/fttl-yt-player.js",
  "type": "module",
  "scripts": {
    "watch": "npm run build --workspaces --if-present && nodemon"
  },
  "nodemonConfig": {
    "events": {
      "restart": "npm run build --workspace=build"
    },
    "exec": "node -e \"\"",
    "ext": "*",
    "ignore": "bin/",
    "watch": "src"
  },
  "keywords": [],
  "author": "Fabrice Sanga",
  "license": "ISC",
  "description": "YouTube play on hover web component",
  "workspaces": [ "build/", "minify/" ],
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
